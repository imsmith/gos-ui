# gos-ui — BEAM consumer of imsmith/design-system.
# `make sync` copies the generated serializations from a design-system checkout.
DESIGN_SYSTEM ?= ../design-system
DEST = priv/static/gos-ui

.PHONY: sync check docs demo

sync:                             ## vendor styles, tokens css, fonts, sprite, and the tokens module (gos-ui.js is ours, kept)
	rm -rf $(DEST)/tokens $(DEST)/fonts $(DEST)/assets $(DEST)/styles.css && mkdir -p $(DEST)/tokens $(DEST)/assets/marks
	cp $(DESIGN_SYSTEM)/styles.css $(DEST)/
	cp $(DESIGN_SYSTEM)/tokens/*.css $(DEST)/tokens/
	cp -r $(DESIGN_SYSTEM)/fonts $(DEST)/fonts
	cp $(DESIGN_SYSTEM)/assets/marks/sprite.svg $(DEST)/assets/marks/
	sed 's/^defmodule DesignSystem.Tokens do/defmodule GosUi.Tokens do/; s|^# GENERATED by tools/elixir.tcl|# GENERATED upstream by tools/elixir.tcl|' \
	  $(DESIGN_SYSTEM)/tokens/design_system_tokens.ex > lib/gos_ui/tokens.ex
	mix format lib/gos_ui/tokens.ex
	git -C $(DESIGN_SYSTEM) rev-parse HEAD > priv/design-system.rev
	@echo "synced from design-system @ $$(cat priv/design-system.rev)"

check:                            ## format, compile clean, test
	mix format --check-formatted
	mix compile --warnings-as-errors
	mix test

docs:                             ## ex_doc into doc/ (local only)
	mix docs

demo:                             ## render demo/index.html from every component and serve it
	mix run demo/render.exs
	@echo "http://127.0.0.1:8767/demo/" && python3 -m http.server 8767 --bind 127.0.0.1
